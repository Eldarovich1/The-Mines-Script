    ["RushMoving"]   = { Color = Color3.fromRGB(255,  50, 50), Name = "💨 RUSH",     isMon=true, isRsh=true },
    ["Ambush"]       = { Color = Color3.fromRGB(255, 140,  0), Name = "🔄 AMBUSH",   isMon=true, isAmb=true },
