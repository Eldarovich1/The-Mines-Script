local MONSTER_NAMES = {}
for k, v in pairs(targets) do
    if v.isMon then MONSTER_NAMES[k] = true end
end

local highlightedObjects = {}
local highlightIsMonster = {}
local lockerHighlights   = {}
local notifiedMonsters = {}
local activeSeeks = {}
local rushAmbushCount = 0

-- ══════════════════════════════════════════════
-- 4. BILLBOARD + HIGHLIGHT + ШКАФЫ
-- ══════════════════════════════════════════════
local function createBillboard(anchorPart, itemName, color, isMonster)
    if not anchorPart or not anchorPart.Parent or anchorPart:FindFirstChild("ItemLabel") then return end
    local bb = Instance.new("BillboardGui")
    bb.Name = "ItemLabel"
    bb.Parent = anchorPart
    bb.Size = UDim2.new(0, isMonster and 220 or 170, 0, isMonster and 46 or 36)
    bb.StudsOffset = Vector3.new(0, isMonster and 5 or 2.5, 0)
    bb.AlwaysOnTop = true
    bb.MaxDistance = 0
    bb.LightInfluence = 0

    local bg = Instance.new("Frame", bb)
    bg.Size = UDim2.new(1,0,1,0)
    bg.BackgroundColor3 = Color3.fromRGB(0,0,0)
    bg.BackgroundTransparency = 0.35
    bg.BorderSizePixel = 0
    Instance.new("UICorner", bg).CornerRadius = UDim.new(0,6)

    local lbl = Instance.new("TextLabel", bg)
    lbl.Size = UDim2.new(1,-8,1,0)
    lbl.Position = UDim2.new(0,4,0,0)
    lbl.BackgroundTransparency = 1
    lbl.Text = itemName
    lbl.TextColor3 = color
    lbl.TextScaled = true
    lbl.Font = Enum.Font.GothamBold
    lbl.TextStrokeTransparency = 0.1
    lbl.TextStrokeColor3 = Color3.fromRGB(0,0,0)
end

local function resolveTarget(obj)
    if obj:IsA("Model") then return obj end
    if obj.Parent and obj.Parent:IsA("Model") then return obj.Parent end
    return obj
end

local function addHighlight(target, color, itemName, isMonster)
    if not target or not target.Parent then return end
    if character and target:IsDescendantOf(character) then return end

    if not highlightedObjects[target] then
        local h = Instance.new("Highlight")
        h.Parent = target
        h.FillColor = color
        h.FillTransparency = isMonster and 0.15 or 0.35
        h.OutlineColor = Color3.fromRGB(255,255,255)
        h.OutlineTransparency = 0
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlightedObjects[target] = h
        highlightIsMonster[target] = isMonster or false
    end

    local anchor = target:IsA("BasePart") and target or 
                  (target:IsA("Model") and (target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart")))

    if anchor then
        createBillboard(anchor, itemName, color, isMonster)
    end
end

local function showLockers()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name == "Locker_Large" then
            local t = resolveTarget(obj)
            if not lockerHighlights[t] then
                local h = Instance.new("Highlight")
                h.Parent = t
                h.FillColor = Color3.fromRGB(100,200,255)
                h.FillTransparency = 0.35
                h.OutlineColor = Color3.fromRGB(255,255,255)
                h.OutlineTransparency = 0
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                lockerHighlights[t] = h
                
                local anchor = t:IsA("BasePart") and t or (t:IsA("Model") and (t.PrimaryPart or t:FindFirstChildWhichIsA("BasePart")))
                if anchor and not anchor:FindFirstChild("LockerLabel") then
                    local bb = Instance.new("BillboardGui")
                    bb.Name = "LockerLabel"
                    bb.Parent = anchor
                    bb.Size = UDim2.new(0,170,0,36)
                    bb.StudsOffset = Vector3.new(0,2.5,0)
                    bb.AlwaysOnTop = true
                    bb.MaxDistance = 0
                    bb.LightInfluence = 0
                    
                    local bg = Instance.new("Frame", bb)
                    bg.Size = UDim2.new(1,0,1,0)
                    bg.BackgroundColor3 = Color3.fromRGB(0,0,0)
                    bg.BackgroundTransparency = 0.35
                    Instance.new("UICorner", bg).CornerRadius = UDim.new(0,6)
                    
                    local lbl = Instance.new("TextLabel", bg)
                    lbl.Size = UDim2.new(1,-8,1,0)
                    lbl.Position = UDim2.new(0,4,0,0)
                    lbl.BackgroundTransparency = 1
                    lbl.Text = "🚪 Шкаф"
                    lbl.TextColor3 = Color3.fromRGB(100,200,255)
                    lbl.TextScaled = true
                    lbl.Font = Enum.Font.GothamBold
                    lbl.TextStrokeTransparency = 0.1
                    lbl.TextStrokeColor3 = Color3.fromRGB(0,0,0)
                end
            end
        end
    end
end

local function hideLockers()
    for t, h in pairs(lockerHighlights) do
        pcall(function()
            if h and h.Parent then h:Destroy() end
            local anchor = t:IsA("BasePart") and t or (t:IsA("Model") and (t.PrimaryPart or t:FindFirstChildWhichIsA("BasePart")))
            if anchor then
                local bb = anchor:FindFirstChild("LockerLabel")
                if bb then bb:Destroy() end
            end
        end)
        lockerHighlights[t] = nil
    end
end

local function onRushAmbushSpawn(obj)
    rushAmbushCount = rushAmbushCount + 1
    showLockers()
    obj.AncestryChanged:Connect(function(_, p)
        if p == nil then
            rushAmbushCount = math.max(0, rushAmbushCount - 1)
            if rushAmbushCount == 0 then hideLockers() end
        end
    end)
end

-- ══════════════════════════════════════════════
-- 5. ОБРАБОТКА
-- ══════════════════════════════════════════════
local function isRealDoor(obj)
    local parent = obj.Parent
    if parent and parent:IsA("Model") then
        local n = parent.Name:lower()
        if (n:find("door") or n:find("exit") or n:find("gate")) and not parent:FindFirstChild("RushSpawn") then 
            return true, parent 
        end
    end
    if obj:IsA("Model") then
        local n = obj.Name:lower()
        if (n:find("door") or n:find("exit") or n:find("gate")) and not obj:FindFirstChild("RushSpawn") then 
            return true, obj 
        end
    end
    return false, nil
end

local function processObject(obj)
    if not obj or not obj.Parent then return end
    if character and obj:IsDescendantOf(character) then return end
    if MONSTER_NAMES[obj.Name] then return end
    
    local data = targets[obj.Name]
    if not data then return end
    
    if obj.Name == "Door" then
        local ok, doorModel = isRealDoor(obj)
        if ok then addHighlight(doorModel, data.Color, data.Name, false) end
    elseif obj.Name == "KeyObtain" then
        if not obj.Parent:IsDescendantOf(character) then
            addHighlight(resolveTarget(obj), data.Color, data.Name, false)
        end
    else
        if obj:IsA("Model") then
            addHighlight(obj, data.Color, data.Name, false)
        elseif obj:IsA("BasePart") then
            local p = obj.Parent
            addHighlight((p and p:IsA("Model") and p.Name == obj.Name) and p or obj, data.Color, data.Name, false)
        end
    end
end

local function handleMonster(obj)
    local data = targets[obj.Name]
    if not data or not data.isMon then return end
    if notifiedMonsters[obj] then return end
    notifiedMonsters[obj] = true
    
    local t = resolveTarget(obj)
    addHighlight(t, data.Color, data.Name, true)
    
    if data.isSee then
        activeSeeks[obj] = true
        startHRPWatch()
        queueWarning("👁️ SEEK ГОНИТСЯ!", "БЕГИ!")
        obj.AncestryChanged:Connect(function(_,p)
            if p == nil then
                activeSeeks[obj] = nil
            end
        end)
    elseif data.isRsh or data.isAmb then
        onRushAmbushSpawn(obj)
        queueWarning(data.isRsh and "💨 RUSH!" or "🔄 AMBUSH!", "Прячься в шкаф!")
    elseif data.isGrm then
        queueWarning("🪨 GRUMBLE!", "Уйди с пути!")
    elseif data.isGig then
        queueWarning("🤭 GIGGLE!", "Берегись потолка!")
    end
end

-- ══════════════════════════════════════════════
-- 6. GUI ПРЕДУПРЕЖДЕНИЙ
-- ══════════════════════════════════════════════
local playerGui = player:WaitForChild("PlayerGui")
local screenGui = Instance.new("ScreenGui", playerGui)
screenGui.ResetOnSpawn = false

local dangerFrame = Instance.new("Frame", screenGui)
dangerFrame.Size = UDim2.new(0,440,0,92)
dangerFrame.Position = UDim2.new(0.5,-220,0.04,0)
dangerFrame.BackgroundColor3 = Color3.fromRGB(8,0,0)
dangerFrame.BackgroundTransparency = 0.2
dangerFrame.Visible = false
Instance.new("UICorner", dangerFrame).CornerRadius = UDim.new(0,10)

local dangerStroke = Instance.new("UIStroke", dangerFrame)
local dangerTitle = Instance.new("TextLabel", dangerFrame)
local dangerSub = Instance.new("TextLabel", dangerFrame)

dangerTitle.Size = UDim2.new(1,-16,0.55,0); dangerTitle.Position = UDim2.new(0,8,0.04,0)
dangerTitle.BackgroundTransparency = 1; dangerTitle.TextScaled = true; dangerTitle.Font = Enum.Font.GothamBold

dangerSub.Size = UDim2.new(1,-16,0.38,0); dangerSub.Position = UDim2.new(0,8,0.60,0)
dangerSub.BackgroundTransparency = 1; dangerSub.TextColor3 = Color3.fromRGB(255,210,210)
dangerSub.TextScaled = true; dangerSub.Font = Enum.Font.Gotham

local warnQueue = {}
local warnActive = false

function queueWarning(title, sub)
    table.insert(warnQueue, {
        title = title,
        sub = sub or "",
        titleColor = Color3.fromRGB(255,80,80),
        strokeColor = Color3.fromRGB(255,50,50)
    })
end

task.spawn(function()
    while true do
        if #warnQueue > 0 and not warnActive then
            warnActive = true
            local w = table.remove(warnQueue, 1)
            dangerTitle.Text = w.title
            dangerTitle.TextColor3 = w.titleColor
            dangerSub.Text = w.sub
            dangerStroke.Color = w.strokeColor
            dangerFrame.Visible = true
            task.wait(1.1)
            dangerFrame.Visible = false
            warnActive = false
        end
        task.wait(0.1)
    end
end)

-- ══════════════════════════════════════════════
-- 7. СКАНИРОВАНИЕ (убраны очереди для максимальной скорости появления)
-- ══════════════════════════════════════════════
Workspace.DescendantAdded:Connect(function(desc)
    if MONSTER_NAMES[desc.Name] then
        task.defer(handleMonster, desc)
    else
        task.defer(processObject, desc)
    end
end)

local function scanObjects()
    local all = Workspace:GetDescendants()
    for _, obj in ipairs(all) do
        if MONSTER_NAMES[obj.Name] then
            pcall(handleMonster, obj)
        else
            pcall(processObject, obj)
        end
    end
    showLockers() -- сразу показываем шкафы
end

-- ══════════════════════════════════════════════
-- 8. РЕСПАВН
-- ══════════════════════════════════════════════
player.CharacterAdded:Connect(function(newChar)
    for _, h in pairs(highlightedObjects) do
        if h and h.Parent then h:Destroy() end
    end
    hideLockers()
    stopHRPWatch()
    
    highlightedObjects = {}
    highlightIsMonster = {}
    notifiedMonsters = {}
    activeSeeks = {}
    rushAmbushCount = 0
    
    character = newChar
    humanoid  = character:WaitForChild("Humanoid")
    rootPart  = character:WaitForChild("HumanoidRootPart")
    
    task.wait(0.5)
    applyBoost()
    applyFullbright()
    scanObjects()
end)

-- ЗАПУСК
task.spawn(function()
    while true do
        task.wait(12)
        applyBoost()
        applyFullbright()
    end
end)

scanObjects()
applyBoost()
applyFullbright()

print("✅ DOORS Mines ESP v8.9.2 (Soft Speed +15 + Fast ESP) загружен!")
print("   Скорость: ~31 (мягкий буст +15)")
print("   ESP теперь появляется почти мгновенно")
