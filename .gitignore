-- ██████████████████████████████████████████████
--   DOORS: THE MINES — ESP v8.9.1 (LOW CPU + DOOR FIX + PERMANENT HIGHLIGHTS)
-- ██████████████████████████████████████████████

local Players           = game:GetService("Players")
local Workspace         = game:GetService("Workspace")
local RunService        = game:GetService("RunService")
local Lighting          = game:GetService("Lighting")
local LocalPlayer = Players.LocalPlayer

local player    = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid  = character:WaitForChild("Humanoid")
local rootPart  = character:WaitForChild("HumanoidRootPart")

-- ══════════════════════════════════════════════
-- 1. СКОРОСТЬ
-- ══════════════════════════════════════════════
local WALK_SPEED     = 21
local SEEK_SPEED     = 25
local SEEK_GONE_DIST = 280
local activeSeeks    = {}
local seekActive     = false

local FREEZE_NAMES   = { BodyVelocity = true, LinearVelocity = true, BodyPosition = true }

local hrpConn = nil
local function startHRPWatch()
    if hrpConn then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    hrpConn = hrp.ChildAdded:Connect(function(child)
        if FREEZE_NAMES[child.Name] or FREEZE_NAMES[child.ClassName] then
            task.defer(function()
                if child and child.Parent then child:Destroy() end
            end)
        end
    end)
end

local function stopHRPWatch()
    if hrpConn then hrpConn:Disconnect(); hrpConn = nil end
end

local function isSeekNearby()
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    for seekObj in pairs(activeSeeks) do
        if seekObj and seekObj.Parent then
            local part = seekObj:IsA("Model") and (seekObj.PrimaryPart or seekObj:FindFirstChildWhichIsA("BasePart")) or seekObj
            if part and (part.Position - root.Position).Magnitude < SEEK_GONE_DIST then return true end
        else
            activeSeeks[seekObj] = nil
        end
    end
    return false
end

task.spawn(function()
    while not isScriptFinished do
        pcall(function()
            local mainUI = LocalPlayer.PlayerGui:FindFirstChild("MainUI")
            if mainUI then
                local modules = mainUI.Initiator.Main_Game.RemoteListener.Modules
                local a90 = modules:FindFirstChild("A90")
                if a90 then a90:Destroy() end
            end
        end)
        task.wait(0.1)
    end
end)

task.spawn(function()
    while not isScriptFinished do
        pcall(function()
            local mainUI = LocalPlayer.PlayerGui:FindFirstChild("MainUI")
            if mainUI then
                local modules = mainUI.Initiator.Main_Game.RemoteListener.Modules
                local SCR = modules:FindFirstChild("Screech")
                if SCR then SCR:Destroy() end
            end
        end)
        task.wait(0.1)
    end
end)

local function applySpeed()
    if not humanoid or humanoid.WalkSpeed == 0 then return end
    local target = isSeekNearby() and SEEK_SPEED or WALK_SPEED
    if humanoid.WalkSpeed ~= target then
        humanoid.WalkSpeed = target
    end
end

RunService.Heartbeat:Connect(function()
    if seekActive and humanoid then
        humanoid.WalkSpeed = SEEK_SPEED
    end
end)

-- ══════════════════════════════════════════════
-- 2. LOW CPU ОПТИМИЗАЦИЯ
-- ══════════════════════════════════════════════
local lastScan = 0
local highlightedObjects = {}
local highlightIsMonster = {}
local lockerHighlights   = {}
local highlightsHidden   = false

local function hideItemHighlights()
    if highlightsHidden then return end
    highlightsHidden = true
    local list = {}
    for target, h in pairs(highlightedObjects) do
        if not highlightIsMonster[target] and h and h.Parent then
            table.insert(list, {h = h, isLocker = false, anchor = target})
        end
    end
    for t, h in pairs(lockerHighlights) do
        if h and h.Parent then
            table.insert(list, {h = h, isLocker = true, anchor = t})
        end
    end
    task.spawn(function()
        for i, item in ipairs(list) do
            if not highlightsHidden then break end
            pcall(function()
                if item.h then item.h.Enabled = false end
                if item.anchor then
                    local bb = item.anchor:FindFirstChild(item.isLocker and "LockerLabel" or "ItemLabel")
                    if bb then bb.Enabled = false end
                end
            end)
            if i % 15 == 0 then RunService.Heartbeat:Wait() end
        end
    end)
end

local function showItemHighlights()
    if not highlightsHidden then return end
    highlightsHidden = false
    local list = {}
    for target, h in pairs(highlightedObjects) do
        if not highlightIsMonster[target] and h and h.Parent then
            table.insert(list, {h = h, isLocker = false, anchor = target})
        end
    end
    for t, h in pairs(lockerHighlights) do
        if h and h.Parent then
            table.insert(list, {h = h, isLocker = true, anchor = t})
        end
    end
    task.spawn(function()
        for i, item in ipairs(list) do
            if highlightsHidden then break end
            pcall(function()
                if item.h then item.h.Enabled = true end
                if item.anchor then
                    local bb = item.anchor:FindFirstChild(item.isLocker and "LockerLabel" or "ItemLabel")
                    if bb then bb.Enabled = true end
                end
            end)
            if i % 25 == 0 then task.wait() end
        end
    end)
end

local function startSeekOverride()
    if seekActive then return end
    seekActive = true
    startHRPWatch()
    if humanoid then humanoid.WalkSpeed = SEEK_SPEED end
    hideItemHighlights()
end

local function stopSeekOverride()
    if not seekActive then return end
    seekActive = false
    stopHRPWatch()
    showItemHighlights()
    applySpeed()
end

task.spawn(function()
    while true do
        task.wait(0.3)
        if seekActive and not isSeekNearby() then
            stopSeekOverride()
        elseif not seekActive then
            applySpeed()
        end
    end
end)

-- ══════════════════════════════════════════════
-- 3. FULLBRIGHT + КАМЕРА
-- ══════════════════════════════════════════════
local camera = Workspace.CurrentCamera

local function watchCamera()
    camera:GetPropertyChangedSignal("CameraType"):Connect(function()
        if seekActive and camera.CameraType == Enum.CameraType.Scriptable then
            task.defer(function()
                if seekActive then camera.CameraType = Enum.CameraType.Custom end
            end)
        end
    end)
end
watchCamera()

local fullbrightLock = false
local function applyFullbright()
    if fullbrightLock then return end
    fullbrightLock = true
    Lighting.Brightness = 2
    Lighting.ClockTime = 14
    Lighting.FogEnd = 100000
    Lighting.FogStart = 100000
    Lighting.GlobalShadows = false
    Lighting.Ambient = Color3.fromRGB(255,255,255)
    Lighting.OutdoorAmbient = Color3.fromRGB(255,255,255)
    for _, e in pairs(Lighting:GetChildren()) do
        if e:IsA("PostEffect") or e:IsA("Sky") or e:IsA("Atmosphere") then e:Destroy() end
    end
    fullbrightLock = false
end
applyFullbright()

Lighting.ChildAdded:Connect(function(c)
    if c:IsA("PostEffect") or c:IsA("Sky") or c:IsA("Atmosphere") then
        task.defer(function() if c.Parent then c:Destroy() end end)
    end
end)

-- ══════════════════════════════════════════════
-- 4. СПИСОК ЦЕЛЕЙ
-- ══════════════════════════════════════════════
