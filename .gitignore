-- ██████████████████████████████████████████████
--   DOORS: THE MINES — ESP v8.9.2 (SOFT SPEED +15 + FAST ESP)
-- ██████████████████████████████████████████████

local Players           = game:GetService("Players")
local Workspace         = game:GetService("Workspace")
local RunService        = game:GetService("RunService")
local Lighting          = game:GetService("Lighting")
local LocalPlayer       = Players.LocalPlayer

local player    = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid  = character:WaitForChild("Humanoid")
local rootPart  = character:WaitForChild("HumanoidRootPart")

-- ══════════════════════════════════════════════
-- 1. SOFT SPEED +15
-- ══════════════════════════════════════════════
local BOOST = 15

local function applyBoost()
    local char = LocalPlayer.Character
    if not char then return end
    
    char:SetAttribute("SpeedBoostExtra", BOOST)
    
    local hum = char:FindFirstChild("Humanoid")
    if hum and hum.WalkSpeed > 0 then
        hum.WalkSpeed = 16 + BOOST  -- базовые 16 + 15 = 31
    end
end

if LocalPlayer.Character then
    applyBoost()
end
LocalPlayer.CharacterAdded:Connect(applyBoost)

-- Убраны все старые WALK_SPEED / SEEK_SPEED / RenderStepped / Heartbeat скорости

local FREEZE_NAMES = { BodyVelocity = true, LinearVelocity = true, BodyPosition = true }
local hrpConn = nil

local function startHRPWatch()
    if hrpConn then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    hrpConn = hrp.ChildAdded:Connect(function(child)
        if FREEZE_NAMES[child.Name] or FREEZE_NAMES[child.ClassName] then
            task.defer(function()
                if child and child.Parent then child:Destroy() end
            end)
        end
    end)
end

local function stopHRPWatch()
    if hrpConn then hrpConn:Disconnect(); hrpConn = nil end
end

-- ══════════════════════════════════════════════
-- 2. FULLBRIGHT + КАМЕРА
-- ══════════════════════════════════════════════
local camera = Workspace.CurrentCamera

local function watchCamera()
    camera:GetPropertyChangedSignal("CameraType"):Connect(function()
        if camera.CameraType == Enum.CameraType.Scriptable then
            task.defer(function()
                camera.CameraType = Enum.CameraType.Custom
            end)
        end
    end)
end
watchCamera()

local function applyFullbright()
    Lighting.Brightness = 2
    Lighting.ClockTime = 14
    Lighting.FogEnd = 100000
    Lighting.FogStart = 100000
    Lighting.GlobalShadows = false
    Lighting.Ambient = Color3.fromRGB(255,255,255)
    Lighting.OutdoorAmbient = Color3.fromRGB(255,255,255)
    
    for _, e in pairs(Lighting:GetChildren()) do
        if e:IsA("PostEffect") or e:IsA("Sky") or e:IsA("Atmosphere") then 
            e:Destroy() 
        end
    end
end
applyFullbright()

Lighting.ChildAdded:Connect(function(c)
    if c:IsA("PostEffect") or c:IsA("Sky") or c:IsA("Atmosphere") then
        task.defer(function() if c.Parent then c:Destroy() end end)
    end
end)

-- ══════════════════════════════════════════════
-- 3. СПИСОК ЦЕЛЕЙ
-- ══════════════════════════════════════════════
